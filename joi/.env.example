# === Joi konfiguratsiyasi ===

# Telegram bot tokeni (@BotFather dan oling)
TELEGRAM_BOT_TOKEN=

# Google Gemini API kaliti — Joi ning "miyasi" (BEPUL).
# https://aistudio.google.com/app/apikey dan oling (karta kerak emas).
GEMINI_API_KEY=

# Ovozli xabarlarni matnga o'girish uchun (ixtiyoriy).
# Agar bo'sh qolsa, ovozli xabar kelganda Joi "yozib yuboring" deydi.
# OpenAI Whisper STT kaliti (https://platform.openai.com):
OPENAI_API_KEY=

# Webhook server porti (4Prep production sayti xabar yuborishi uchun)
PORT=8787

# Webhook'ni himoyalash uchun maxfiy kalit (sayt shu kalit bilan murojaat qiladi)
WEBHOOK_SECRET=almashtiring-maxfiy-kalit

# Joi qaysi modelda ishlasin (default: gemini-2.5-flash — bepul).
# "Model topilmadi" xatosi chiqsa: gemini-2.0-flash yoki gemini-1.5-flash sinang.
JOI_MODEL=gemini-2.5-flash
